# Email Configuration for Password Reset
# ========================================
# Copy this file to .env and fill in your email settings
# The server will automatically use these settings if provided

# Required: Your email address
EMAIL_USER=your-email@gmail.com

# Required: Your email password or app-specific password
# For Gmail: Create an app password at https://myaccount.google.com/apppasswords
# For other providers: Use your regular password or app-specific password
EMAIL_PASS=your-app-password

# Optional: SMTP server host (defaults to Gmail)
# Common SMTP hosts:
# - Gmail: smtp.gmail.com
# - Outlook: smtp-mail.outlook.com
# - Yahoo: smtp.mail.yahoo.com
# - Custom: your-smtp-server.com
EMAIL_HOST=smtp.gmail.com

# Optional: SMTP server port (defaults to 587)
# Common ports:
# - 587: STARTTLS (recommended)
# - 465: SSL/TLS
# - 25: Unencrypted (not recommended)
EMAIL_PORT=587

# Optional: Email "from" address (defaults to EMAIL_USER)
EMAIL_FROM=noreply@yourdomain.com

# Security: JWT Secret (change this in production!)
JWT_SECRET=your-secret-key-change-this-in-production

# ========================================
# Instructions for Gmail:
# ========================================
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification if not already enabled
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Create an app password for "Mail"
# 5. Use that 16-character password as EMAIL_PASS
#
# Example:
# EMAIL_USER=yourname@gmail.com
# EMAIL_PASS=abcd efgh ijkl mnop (remove spaces)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587

# ========================================
# Instructions for Outlook/Hotmail:
# ========================================
# EMAIL_USER=yourname@outlook.com
# EMAIL_PASS=your-password
# EMAIL_HOST=smtp-mail.outlook.com
# EMAIL_PORT=587

# ========================================
# Instructions for Yahoo:
# ========================================
# 1. Generate app password at https://login.yahoo.com/account/security
# EMAIL_USER=yourname@yahoo.com
# EMAIL_PASS=your-app-password
# EMAIL_HOST=smtp.mail.yahoo.com
# EMAIL_PORT=587

# ========================================
# Testing Email Configuration:
# ========================================
# 1. Copy this file to .env
# 2. Fill in your email settings
# 3. Restart the server: npm start
# 4. Look for "✅ Email service ready to send messages"
# 5. Try the password reset flow
