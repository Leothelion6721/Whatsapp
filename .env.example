# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret (Change this in production!)
JWT_SECRET=your-secret-key-change-this-in-production

# Mailjet Email Configuration
# Get your API credentials from https://app.mailjet.com/account/apikeys
MAILJET_API_KEY=your_mailjet_api_key_here
MAILJET_SECRET_KEY=your_mailjet_secret_key_here

# Email Settings
SENDER_EMAIL=noreply@yourdomain.com
APP_URL=http://localhost:3000

# Note: Never commit your actual .env file with real credentials!
# This is just an example file to show what variables are needed.
